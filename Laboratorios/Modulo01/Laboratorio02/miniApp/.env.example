# Copia este archivo a .env y rellena los valores. El .env real NO se versiona.

# Clave de API del proveedor (obligatoria)
OPENAI_API_KEY=tu_clave_aqui

# URL base de la API (obligatoria si usas un gateway o proveedor compatible con OpenAI)
OPENAI_BASE_URL=https://tu-endpoint.example.com/v1

# Modelo a usar (opcional, por defecto "fast")
MODELO=fast
